# Copy to .env. Never commit .env or share merchant keys in browser code.
HOST=127.0.0.1
PORT=5173
# Local default is http://localhost:5173; Vercel URLs are detected automatically.
# Set this to your custom domain if needed. Do not use localhost on Vercel.
BASE_URL=
# Replace with a randomly generated secret for staff access.
ADMIN_TOKEN=replace-with-a-long-random-secret
PAYMENT_MODE=mock
# mock: no money moves; sandbox: ABA test merchant; production: real money.

# Optional broader retailer comparison. Without a key, accessible Amazon regional pages are searched directly.
# SerpApi Google Shopping searches the registered regional markets.
SERPAPI_KEY=
# Optional paid Amazon extraction + regional search adapter when direct reads are blocked.
RAINFOREST_API_KEY=

# Immediate payment: ABA PayWay hosted checkout with KHQR and cards.
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Must be enabled deliberately after validating prices and delivery fees.
ENABLE_LIVE_CHECKOUT=false
# Test defaults only. Configure actual pricing before sandbox/production checkout.
SERVICE_FEE_RATE=0.08
SHIPPING_USD=12.00
